# iCloud CalDAV credentials. Use an Apple app-specific password.
ICLOUD_USERNAME=your-apple-id@example.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ICLOUD_DEFAULT_CALENDAR=
ICLOUD_TIMEZONE=Europe/Berlin

# Poll calendar event caches in the background; warm the default window on startup.
ICLOUD_CACHE_REFRESH_ENABLED=true
ICLOUD_CACHE_REFRESH_INTERVAL_SECONDS=30

# Optional dedicated iCloud Mail settings. If left empty, the ICLOUD_* account
# credentials above are reused. Apple requires an app-specific password.
IMAP_USERNAME=
IMAP_APP_PASSWORD=
IMAP_HOST=imap.mail.me.com
IMAP_PORT=993
IMAP_DEFAULT_MAILBOX=INBOX
IMAP_DRAFTS_MAILBOX=Drafts
# Header cache: refresh every 5 minutes, covering up to 1000 messages from 100 days.
IMAP_EMAIL_CACHE_TTL_SECONDS=300
IMAP_EMAIL_CACHE_DAYS=100
IMAP_EMAIL_CACHE_MAX_MESSAGES=1000

# Optional mail/PDF semantic search; OpenAI computes vectors, no local GPU needed.
# Mail and PDF text plus search queries are sent to the OpenAI embeddings API.
MAIL_SEARCH_ENABLED=false
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072
QDRANT_VERSION=v1.19.1
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=icloud-mail
MAIL_SEARCH_EMBEDDING_MODE=batch
MAIL_SEARCH_BATCH_SIZE=100
MAIL_SEARCH_POLL_SECONDS=30

# OpenAI Secure MCP Tunnel runtime settings.
# Create/associate the tunnel in Platform tunnel settings first.
CONTROL_PLANE_API_KEY=sk-...
CONTROL_PLANE_TUNNEL_ID=tunnel_0123456789abcdef0123456789abcdef
TUNNEL_CLIENT_VERSION=v0.0.15
